# PaySuite merchant credentials. Configure real values only in the hosting
# environment; never commit them.
PAYSUITE_API_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
PAYSUITE_API_URL=https://paysuite.tech/api/v1

# Web Push VAPID keys. Generate a P-256 key pair and configure the private
# value only in the hosting environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://trove-decor-platform.irachande7.chatgpt.site

# Transactional email through Resend. A verified sending domain is required
# before real invitations can be delivered.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
EMAIL_FROM=Trove <notifications@example.com>
PUBLIC_APP_URL=https://trove-decor-platform.irachande7.chatgpt.site
